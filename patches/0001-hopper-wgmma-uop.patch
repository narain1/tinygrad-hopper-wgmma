+  def wgmma(a:UOp, b:UOp, acc:UOp, dims:tuple[int, int, int], dtype_in:DType, scale_d:int|UOp=1, gate:UOp|None=None,
+            a_regs:int=0, tnsp_b:bool=False, b_lbo:int=16, wait:int=0):
+    # async warpgroup mma over a K-chunk. a,b are shared-memory pointers (INDEX of a LOCAL buffer) to 128B-swizzled
+    # K-major tiles, acc is a REG buffer. dims=(M,N,K) with K a multiple of 16: renders as ONE asm block doing
+    # fence, K/16 mma_async (descriptors advance 32 bytes per step), commit, wait.
+    # scale_d (first step only): 0 => C=A*B, 1 => C+=A*B; an int UOp makes it runtime (skip zeroing the accumulator).
+    # gate: optional warp-uniform bool, e.g. the warpgroup role in warp specialization.
+    # src = (a, b, acc[, gate][, scale_d]); arg = (dims, dtype_in, scale_d if static else -1, has_gate)
